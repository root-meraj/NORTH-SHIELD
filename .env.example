# ============================================================
#  NorthShield environment
#  NEXT_PUBLIC_* is shipped to the browser — only URLs, never secrets.
#  Everything else is read only in server route handlers (app/api/*).
# ============================================================

# --- Frontend (public) --------------------------------------

# Leave blank to run the mock data endpoints. Point at a backend to go live.
NEXT_PUBLIC_API_URL=

# The trained YOLO vision + terrain risk engine (model_files/api.py).
# Local: http://127.0.0.1:8000   Deployed: your Render/Railway URL   Demo: an ngrok URL
NEXT_PUBLIC_AI_API_URL=http://127.0.0.1:8000

# --- Routing (server only) ---------------------------------
# https://openrouteservice.org/dev/  ->  sign up  ->  Dashboard  ->  request a token
ORS_API_KEY=

# --- Geocoding (server only) -------------------------------
# No key. Nominatim asks for a contact address in the User-Agent.
NOMINATIM_EMAIL=you@example.org

# --- Weather --------------------------------------------------
# Open-Meteo needs no key. Nothing to set.

# --- SMS alerts via Twilio (server only) --------------------
# https://console.twilio.com  ->  Account SID is on the home page
# Console > Account > API keys & tokens  ->  Create API key (Standard)
TWILIO_ACCOUNT_SID=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
# A Twilio phone number you own, e.g. +15005550006  (or  whatsapp:+14155238886  for the sandbox)
TWILIO_FROM=
# Default recipient for road-blocked alerts, e.g. +9198XXXXXXXX
ALERT_SMS_TO=
